# Template: the venv bin/ placeholder in ExecStart/ExecStop is filled in at install time (see README).
[Unit]
Description=haunted-desktop — subtle Halloween Linux overlay
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@VENV_BIN@/haunted-desktop start
ExecStop=@VENV_BIN@/haunted-desktop stop
Restart=on-failure
RestartSec=5
Environment=GDK_BACKEND=x11

[Install]
WantedBy=default.target
