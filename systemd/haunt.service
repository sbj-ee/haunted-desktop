[Unit]
Description=haunt — haunted Linux desktop overlay
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/haunt start
ExecStop=%h/.local/bin/haunt stop
Restart=on-failure
RestartSec=5
# Inherit DISPLAY/WAYLAND_DISPLAY from the user session when started via systemd --user
Environment=GDK_BACKEND=x11

[Install]
WantedBy=default.target
